{
  "name": "forge-quick-access",
  "displayName": "forge-quick-access",
  "description": "A VS Code extension to authenticate with Forge, list sites, and deploy files.",
  "publisher": "beachio",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "forge.authenticate",
        "title": "Forge: Authenticate"
      },
      {
        "command": "forge.listSites",
        "title": "Forge: List Sites"
      },
      {
        "command": "forge.deploy",
        "title": "Forge: Deploy"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Forge Quick Access Configuration",
      "properties": {
        "forgeQuickAccess.forgeToken": {
          "type": "string",
          "default": "",
          "description": "Store Forge API token"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/beachio/forge-quick-access-extension.git"
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "form-data": "^4.0.1",
    "fs": "^0.0.1-security"
  }
}
